flowchart TB
    ROOT["import_config (raiz)\nadditionalProperties: false"]
    ROOT --> SRC["sources*\nnome → CSV, ou\n{file, origin_column: true}"]
    ROOT --> DB["blocos de SGBD destino\npostgres · mongodb\ncassandra · redis · neo4j"]

    DB -->|"entities*"| ENTITY["entity"]
    DB --> REL["relationships\npostgres: from*, to*,\nforeign_key*, references_key\nneo4j: from*, to*, type*,\ncolumns (de columnSpec)"]
    REL -.->|"from, to: nomes\nde entidade"| ENTITY

    ENTITY --> OPT["source (nome ou lista)\nauto_map, csv_columns\ncassandra_partition\ncassandra_cluster"]
    ENTITY --> COLS["columns: columnEntry (oneOf)\nfolha, ou objeto aninhado\n(subdocumento, recursivo)"]
    ENTITY --> FSPEC["filters: filter\ncolumn*, operator*,\nvalue, target_suffix\n(com {value})"]

    COLS --> CSPEC["columnSpec (folha)\ncsv_column, schema_column,\nis_key, db_type"]

    style ROOT fill:#dbeafe,stroke:#2563eb,color:#1e293b
    style SRC fill:#fef3c7,stroke:#d97706,color:#1e293b
    style ENTITY fill:#f8fafc,stroke:#64748b,color:#1e293b
    style CSPEC fill:#dcfce7,stroke:#16a34a,color:#1e293b
    style FSPEC fill:#dcfce7,stroke:#16a34a,color:#1e293b
