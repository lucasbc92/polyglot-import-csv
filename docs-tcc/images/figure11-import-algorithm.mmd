flowchart LR
    subgraph VALID["antes de gravar"]
        direction TB
        START(["linha de\ncomando"]) --> P1["1. carregar e\nvalidar as\nconfigurações\n(etapas 1 e 2)"]
        P1 --> P2["2. conferir os\ncabeçalhos\n(etapa 3)"]
        P2 --> P3["3. verificar\nos SGBDs\n(não no\n--dry-run)"]
        P3 -->|"fora\ndo ar"| STOP(["fim: estado\ne como\niniciar"])
        P3 --> P4["4. leitura de\ninferência"]
        P4 --> P5["5. leitura de\nvalidação\n(etapa 3)"]
        P5 -->|"erro"| FAIL(["fim: nada\ngravado"])
        P5 -->|"--dry-run"| DRY(["fim:\ncontagens"])
    end
    subgraph WRITE["gravação"]
        direction TB
        P6["6. para cada\nSGBD destino"] --> P7["7. preparar\no SGBD"]
        P7 --> P8["8. ler as fontes\ndele em blocos\ne gravar\nem lotes"]
        P8 --> P9["9. fechar\n(recriar FKs\nno PostgreSQL)"]
        P9 --> P6
        P6 -->|fim| END(["fim: métricas\ne contagens"])
    end
    VALID --> WRITE

    style START fill:#dbeafe,stroke:#2563eb,color:#1e293b
    style END fill:#dcfce7,stroke:#16a34a,color:#1e293b
    style DRY fill:#dcfce7,stroke:#16a34a,color:#1e293b
    style P8 fill:#fef3c7,stroke:#d97706,color:#1e293b
    style STOP fill:#fee2e2,stroke:#dc2626,color:#1e293b
    style FAIL fill:#fee2e2,stroke:#dc2626,color:#1e293b
